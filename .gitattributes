# Normalize line endings to LF in the repo; Git will convert on checkout as needed.
* text=auto eol=lf

# Force binary for compiled/binary files
*.pkl binary
*.joblib binary
*.pt binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Force text for specific extensions
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.env text eol=lf
Dockerfile text eol=lf
