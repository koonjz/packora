# =============================================================================
# Packora — environment variables template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=packora
POSTGRES_PASSWORD=changeme          # ← change this
POSTGRES_DB=packora_db
POSTGRES_HOST=db                    # Docker service name; use 'localhost' outside Docker
POSTGRES_PORT=5432

# Assembled automatically by docker-compose; override here only if needed
# DATABASE_URL=postgresql+asyncpg://packora:changeme@db:5432/packora_db

# --- FastAPI --------------------------------------------------------------
APP_ENV=development                  # development | production
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Feature flags --------------------------------------------------------
ENABLE_CV_FEATURE=false              # Set true to enable photo-upload commodity ID (MobileNetV3)
ENABLE_LLM_EXPLANATION=true          # Set false to always use templated explanation

# --- Optional: LLM explanation (only used when ENABLE_LLM_EXPLANATION=true) ---
LLM_PROVIDER=openai                  # openai | anthropic | gemini
LLM_API_KEY=                         # Leave blank for offline-only mode; app will use template fallback
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=5               # Hard timeout; core recommendation never waits longer

# --- Optional: CV feature (only used when ENABLE_CV_FEATURE=true) ---------
CV_MODEL_PATH=backend/app/cv/mobilenetv3_packora.pt
CV_CONFIDENCE_THRESHOLD=0.70
