# =============================================================================
# Packora — environment variables template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# --- PostgreSQL (Neon / local) -----------------------------------------------
POSTGRES_USER=packora
POSTGRES_PASSWORD=changeme          # ← change this
POSTGRES_DB=packora_db
POSTGRES_HOST=db                    # Docker service name; use 'localhost' outside Docker
POSTGRES_PORT=5432

# Full async connection URL (used by backend directly)
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?sslmode=require

# --- FastAPI -----------------------------------------------------------------
APP_ENV=production                   # development | production
SECRET_KEY=replace-with-a-long-random-string
# For Vercel: use * to allow the same-domain frontend, or list your domains
ALLOWED_ORIGINS=*

# --- Feature flags -----------------------------------------------------------
ENABLE_CV_FEATURE=false              # Set true to enable photo-upload commodity ID (MobileNetV3)
ENABLE_LLM_EXPLANATION=true          # Set false to always use templated explanation

# --- Optional: LLM explanation -----------------------------------------------
# Supported providers: openai | anthropic | gemini
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini                  # openai | anthropic | gemini
LLM_API_KEY=                         # Paste your API key here; blank = template fallback
LLM_MODEL=gemini-1.5-flash           # gemini-1.5-flash is free-tier
LLM_TIMEOUT_SECONDS=5               # Hard timeout; core recommendation never waits longer

# --- Vercel frontend env vars (set in Vercel dashboard > Settings > Env Vars) -
# VITE_API_BASE_URL is NOT needed if frontend & backend are on the same domain
# Leave blank (default /api) unless you host backend separately.
# VITE_API_BASE_URL=

# --- Optional: CV feature (only needed when ENABLE_CV_FEATURE=true) ----------
CV_MODEL_PATH=backend/app/cv/mobilenetv3_packora.pt
CV_CONFIDENCE_THRESHOLD=0.70
